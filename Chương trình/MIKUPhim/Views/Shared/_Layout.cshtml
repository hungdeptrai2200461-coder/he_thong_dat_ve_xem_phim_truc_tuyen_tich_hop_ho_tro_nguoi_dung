@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MIKUPhim</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MIKUPhim.styles.css" asp-append-version="true" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background: #0f172a;
            color: white;
            font-family: 'Poppins',sans-serif;
        }

        .navbar {
            background: linear-gradient(90deg, #020617, #071a2b, #0f172a);
            box-shadow: 0 5px 25px rgba(0,0,0,0.6);
            border-bottom: 1px solid rgba(0,230,195,0.2);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            font-size: 22px;
            letter-spacing: 1px;
        }

            .navbar-brand img {
                height: 38px;
                margin-right: 8px;
                border-radius: 50%;
            }

            .navbar-brand span {
                color: #00e6c3;
                font-weight: 700;
            }

        .logo-text {
            color: #00e6c3;
            font-weight: 700;
            letter-spacing: 2px;
            text-shadow: 0 0 5px #00e6c3, 0 0 10px #00e6c3, 0 0 20px rgba(0,230,195,0.6);
            transition: 0.3s;
        }

            .logo-text:hover {
                color: #00fff0;
                text-shadow: 0 0 10px #00fff0, 0 0 30px #00e6c3;
            }

        .nav-link {
            color: #cbd5f5 !important;
            font-weight: 500;
            margin-right: 12px;
            position: relative;
            transition: 0.3s;
        }

            .nav-link::after {
                content: "";
                position: absolute;
                width: 0%;
                height: 2px;
                left: 0;
                bottom: -5px;
                background: #00e6c3;
                transition: 0.3s;
            }

            .nav-link:hover {
                color: #00e6c3 !important;
                transform: translateY(-2px);
            }

                .nav-link:hover::after {
                    width: 100%;
                }

        .nav-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 6px;
            border: 2px solid #00e6c3;
            box-shadow: 0 0 10px rgba(0,230,195,0.5);
        }

        .dropdown-menu {
            background: #020617;
            border: 1px solid #334155;
        }

        .dropdown-item {
            color: white;
        }

            .dropdown-item:hover {
                background: #00e6c3;
                color: black;
            }

        .btn-warning {
            font-weight: 600;
        }

        main {
            min-height: 70vh;
        }

        footer {
            background: #020617;
            border-top: 1px solid #1e293b;
            font-size: 14px;
            letter-spacing: 1px;
        }

        :root {
            --miku-color: #39c5bb;
            --miku-dark: #2da199;
        }

        #miku-chat-wrapper {
            max-width: 90vw;
            max-height: 90vh;
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 9999;
            font-family: 'Poppins',sans-serif;
            touch-action: none;
        }

        #miku-bubble {
            width: 60px;
            height: 60px;
            background: var(--miku-color);
            border-radius: 50%;
            cursor: grab;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s;
            user-select: none;
        }

            #miku-bubble:hover {
                transform: scale(1.1);
            }

            #miku-bubble img {
                width: 80%;
                border-radius: 50%;
                background: white;
                pointer-events: none;
            }

        #miku-chat-window {
            width: 320px;
            height: 450px;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 15px;
            display: none;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: absolute;
            bottom: 70px;
            right: 0;
            overflow: hidden;
        }

        .miku-header {
            background: var(--miku-color);
            color: #0f172a;
            padding: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: bold;
        }

        #miku-chat-content {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #0f172a;
        }

        .msg-bot, .msg-user {
            padding: 8px 12px;
            border-radius: 12px;
            font-size: 13px;
            max-width: 85%;
        }

        .msg-bot {
            background: #334155;
            color: white;
            align-self: flex-start;
        }

        .msg-user {
            background: var(--miku-color);
            color: #0f172a;
            align-self: flex-end;
            font-weight: 500;
        }

        .miku-footer {
            padding: 10px;
            display: flex;
            gap: 5px;
            border-top: 1px solid #334155;
        }

        #miku-input {
            flex: 1;
            background: #1e293b;
            border: 1px solid #334155;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            outline: none;
        }

        .miku-card {
            display: flex;
            gap: 10px;
            background: #1e293b;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 10px;
            border: 1px solid rgba(0,255,200,0.2);
        
        }

        .miku-card-img {
            width: 70px;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
        }

        .miku-card-content {
            flex: 1;
        }

        .miku-card-text {
            font-size: 13px;
            margin-bottom: 5px;
        }

        .miku-btn {
            display: inline-block;
            padding: 4px 8px;
            background: #39c5bb;
            color: #0f172a;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
        }

            .miku-btn:hover {
                background: #2da199;
            }

      /* ========================================
   🎬 MOVIE SLIDER (KHUNG SCROLL NGANG)
======================================== */
.chat-movie-slider {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 8px;
}

.chat-movie-slider::-webkit-scrollbar {
    height: 6px;
}

.chat-movie-slider::-webkit-scrollbar-thumb {
    background: #00e6c3;
    border-radius: 10px;
}

/* ========================================
   🎬 CARD PHIM / COMBO / KHUYẾN MÃI
======================================== */
.chat-movie-card {
    min-width: 110px;
    max-width: 130px; /* 🔥 fix nhỏ lại */
    background: #1e293b;
    border-radius: 10px;
    padding: 6px;
    text-align: center;
    flex-shrink: 0;
    transition: 0.3s;
    box-shadow: 0 0 8px rgba(0,255,200,0.15);
}

.chat-movie-card:hover {
    transform: scale(1.05);
    box-shadow: 0 0 12px #00e6c3;
}

/* ========================================
   🖼️ ẢNH (QUAN TRỌNG NHẤT)
======================================== */
.movie-poster,
.chat-movie-card img {
    width: 100%;
    height: 100px; /* 🔥 giảm mạnh để fit chatbot */
    object-fit: cover;
    border-radius: 6px;
}

/* ========================================
   📝 TEXT
======================================== */
.chat-movie-title {
    font-size: 11px;
    line-height: 1.3;
    margin: 5px 0;
    color: white;
    word-break: break-word;
}

/* mô tả nếu có */
.movie-desc {
    font-size: 10px;
    opacity: 0.8;
    margin-bottom: 4px;
}

/* ========================================
   🔘 BUTTON
======================================== */
.chat-btn,
.movie-btn {
    display: inline-block;
    padding: 3px 6px;
    background: #00e6c3;
    color: #0f172a;
    border-radius: 5px;
    font-size: 10px;
    text-decoration: none;
}

/* ========================================
   📱 QUICK MENU (NÚT GỢI Ý)
======================================== */
        .chat-quick-menu {
            position: sticky;
            top: 0;
            background: #0f172a;
            padding-bottom: 5px;
            z-index: 5;
        }

.quick-btn {
    background: #00e6c3;
    border: none;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    cursor: pointer;
    transition: 0.2s;
}

.quick-btn:hover {
    background: #00fff0;
}

/* ========================================
   🎨 STYLE MIKU
======================================== */
.text-miku {
    color: #00e6c3;
}

.btn-miku {
    background: #00e6c3;
    color: #0f172a;
    border: none;
    font-weight: 600;
}

.btn-miku:hover {
    background: #00fff0;
}

.btn-miku-outline {
    border: 1px solid #00e6c3;
    color: #00e6c3;
}

.btn-miku-outline:hover {
    background: #00e6c3;
    color: #0f172a;
}

/* ========================================
   📱 RESPONSIVE (SIÊU QUAN TRỌNG)
======================================== */
@@media (max-width: 768px) {
    .chat-movie-card {
        min-width: 100px;
        max-width: 110px;
    }

    .movie-poster {
        height: 90px;
    }
}
    </style>
</head>

<body>

    <div id="miku-chat-wrapper">

        <div id="miku-chat-window">
            <div class="miku-header">
                <span>Miku Assistant</span>
                <button onclick="toggleMikuChat()" style="background:none;border:none;color:#0f172a;font-weight:bold;">✕</button>
            </div>

            <div id="miku-chat-content">

                <div class="msg-bot">
                    Miku chào bạn! Bạn cần Miku hỗ trợ gì về phim không? 🎵
                </div>

                <!-- 🔥 MENU LUÔN HIỆN -->
                <div class="chat-quick-menu">
                    <button class="quick-btn" onclick="sendMikuMessageFromBtn('phim hot')">🔥 Phim HOT</button>
                    <button class="quick-btn" onclick="sendMikuMessageFromBtn('phim đang chiếu')">🎬 Đang chiếu</button>
                    <button class="quick-btn" onclick="sendMikuMessageFromBtn('combo')">🍿 Combo</button>
                    <button class="quick-btn" onclick="sendMikuMessageFromBtn('khuyến mãi')">🎉 Khuyến mãi</button>
                </div>

            </div>

            <div class="miku-footer">
                <input type="text" id="miku-input" placeholder="Hỏi Miku..." onkeypress="if(event.key==='Enter') sendMikuMessage()">
                <button onclick="sendMikuMessage()" style="background:var(--miku-color);border:none;border-radius:50%;width:30px;height:30px;">➤</button>
            </div>

        </div>

        <div id="miku-bubble">
            <img src="~/images/logo.png" alt="Miku">
        </div>

    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="MIKUPhim Logo" />
                    <span class="logo-text">MIKU CINEMAS</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="ChinhSach">Chính sách</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="KhuyenMai">Tin mới & ưu đãi</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="HoTro" asp-action="Index">Hỗ trợ</a>
                        </li>

                        @if (Context.Session.GetInt32("MaNguoiDung") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="VeCuaToi">Vé của tôi</a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (Context.Session.GetString("HoTen") != null)
                        {

                            <li class="nav-item dropdown me-3">

                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" data-bs-toggle="dropdown">

                                    <img src="/images/avatars/@Context.Session.GetString("Avatar")" class="nav-avatar" />

                                    <span class="fw-bold text-miku">
                                        @Context.Session.GetString("HoTen")
                                    </span>

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ThongTinCaNhan">
                                            Hồ sơ cá nhân
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="VeCuaToi">
                                            Vé của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="LichSuVe">
                                            Lịch sử vé
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="DoiMatKhau">
                                            Đổi mật khẩu
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            Đăng xuất
                                        </a>
                                    </li>

                                </ul>

                            </li>

                        }
                        else
                        {

                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-miku-outline" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-sm btn-miku" asp-controller="Account" asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>

                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-light mt-5 py-4">
        <div class="container text-center">
            <p class="mb-1 fw-bold">MIKU Cinema</p>
            <p class="mb-1">Hệ thống đặt vé xem phim trực tuyến</p>
            <p class="mb-0">© 2026 - MIKUPhim | Đồ án Web đặt vé xem phim</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required:false)

    <script>

        let wrapper, bubble, chatWin;
        let isDragging = false;
        let startX, startY;

        $(document).ready(function () {

            wrapper = document.getElementById('miku-chat-wrapper');
            bubble = document.getElementById('miku-bubble');
            chatWin = $('#miku-chat-window');

            const savedX = localStorage.getItem("miku_x");
            const savedY = localStorage.getItem("miku_y");

            if (savedX && savedY) {

                let x = parseInt(savedX);
                let y = parseInt(savedY);

                let maxX = window.innerWidth - 80;
                let maxY = window.innerHeight - 80;

                // Fix nếu bị lưu sai vị trí
                if (x < 0 || x > maxX || y < 0 || y > maxY) {
                    localStorage.removeItem("miku_x");
                    localStorage.removeItem("miku_y");
                }
                else {
                    wrapper.style.left = x + "px";
                    wrapper.style.top = y + "px";
                    wrapper.style.bottom = "auto";
                    wrapper.style.right = "auto";
                }
            }

            bubble.addEventListener('mousedown', function (e) {

                isDragging = false;
                startX = e.clientX;
                startY = e.clientY;

                function onMouseMove(e) {

                    if (Math.abs(e.clientX - startX) > 5 || Math.abs(e.clientY - startY) > 5) {

                        isDragging = true;

                        wrapper.style.left = (e.clientX - 30) + 'px';
                        wrapper.style.top = (e.clientY - 30) + 'px';
                        wrapper.style.bottom = 'auto';
                        wrapper.style.right = 'auto';

                    }

                }

                function onMouseUp() {

                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);

                    if (!isDragging) {
                        toggleMikuChat();
                    }
                    else {

                        let winW = window.innerWidth;
                        let currLeft = wrapper.offsetLeft;

                        /* nâng cấp nhỏ tránh kéo ra khỏi màn hình */

                        if (currLeft < 10) {
                            wrapper.style.left = "10px";
                        }

                        if (currLeft > winW - 80) {
                            wrapper.style.left = (winW - 80) + "px";
                        }

                        if (currLeft + 30 < winW / 2) {
                            wrapper.style.left = '20px';
                            chatWin.css({ 'left': '0', 'right': 'auto' });
                        }
                        else {
                            wrapper.style.left = (winW - 80) + 'px';
                            chatWin.css({ 'left': 'auto', 'right': '0' });
                        }

                    }

                    localStorage.setItem("miku_x", wrapper.style.left);
                    localStorage.setItem("miku_y", wrapper.style.top);

                }

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);

            });

        });

        function toggleMikuChat() {

            const bubbleRect = bubble.getBoundingClientRect();
            const screenHeight = window.innerHeight;

            if (bubbleRect.top < screenHeight / 2) {

                chatWin.css({
                    bottom: "auto",
                    top: "70px"
                });

            }
            else {

                chatWin.css({
                    top: "auto",
                    bottom: "70px"
                });

            }

            if (chatWin.is(":visible")) {
                chatWin.slideUp(150);
            }
            else {
                chatWin.css("display", "flex").hide().slideDown(200);
            }

        }

        function sendMikuMessage() {

            var input = $('#miku-input');
            var message = input.val().trim();
            if (!message) return;

            $('#miku-chat-content').append('<div class="msg-user">' + message + '</div>');
            input.val('');

            var typingId = 'typing-' + Date.now();

            $('#miku-chat-content').append('<div class="msg-bot" id="' + typingId + '">Miku đang nghĩ...</div>');

            var objDiv = document.getElementById("miku-chat-content");
            objDiv.scrollTop = objDiv.scrollHeight;

            $.ajax({
                url: "/ChatBot/Ask",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ message: message }),

                success: function (data) {

                   
                    // ===============================
                    // 🎬 MOVIE LIST (NÂNG CẤP SCROLL NGANG)
                    // ===============================
                    if (Array.isArray(data)) {

                        let html = "";
                        let movieHtml = `<div class="chat-movie-slider">`;

                        data.forEach(item => {

                            // 🎬 Nếu là phim (có link Details)
                            if (item.link && item.link.includes("Details")) {

                                movieHtml += `
                    <div class="chat-movie-card">

                        ${item.image ? `<img src="/images/${item.image}" class="movie-poster">` : ""}

                        <div class="chat-movie-title">
                            ${item.text.split("\n")[0]}
                        </div>

                        <a href="${item.link}" class="chat-btn">Mua vé</a>

                    </div>
                    `;
                            }
                            else {
                                html += `
                <div class="miku-card">

                    ${item.image ? `<img src="/images/${item.image}" class="miku-card-img">` : ""}

                    <div class="miku-card-content">

                        <div class="miku-card-text">
                            ${item.text.replace(/\n/g, "<br>")}
                        </div>

                        ${item.link ? `<a href="${item.link}" class="miku-btn">Xem</a>` : ""}

                    </div>

                </div>
            `;
                            }

                        });

                        movieHtml += `</div>`;

                        // nếu có phim thì add slider
                        if (movieHtml !== `<div class="chat-movie-slider"></div>`) {
                            html += movieHtml;
                        }

                        $('#' + typingId).html(html);
                    }
                    else {

                        $('#' + typingId).html(data.text);

                    }

                    objDiv.scrollTop = objDiv.scrollHeight;
                },

                error: function () {

                    $('#' + typingId).html("Miku đang nghỉ...");
                }
            });

        }
        function sendMikuMessageFromBtn(text) {
            $('#miku-input').val(text);
            sendMikuMessage();
        }

    </script>

</body>
</html>
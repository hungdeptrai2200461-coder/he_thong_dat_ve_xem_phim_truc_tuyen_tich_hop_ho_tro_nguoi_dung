@model List<MIKUPhim.Models.YEUCAUHOTRO>
@{
    ViewData["Title"] = "Yêu cầu hỗ trợ của tôi";
}

<div class="container py-5 yeucau-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Yêu cầu hỗ trợ của tôi</h3>
        <a asp-action="Index" class="btn btn-outline-info">Gửi yêu cầu mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            Bạn chưa gửi yêu cầu hỗ trợ nào.
        </div>
    }
    else
    {
        foreach (var y in Model)
        {
            <div class="yeucau-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <span class="badge bg-secondary">#@y.MaYeuCau</span>
                        <strong class="ms-2">@y.TieuDe</strong>
                    </div>
                    <div>
                        @if (y.TrangThai == MIKUPhim.Models.YEUCAUHOTRO.TrangThaiDaTraLoi)
                        {
                            <span class="badge bg-success">@y.TenTrangThai</span>
                        }
                        else if (y.TrangThai == MIKUPhim.Models.YEUCAUHOTRO.TrangThaiDangXuLy)
                        {
                            <span class="badge bg-warning text-dark">@y.TenTrangThai</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@y.TenTrangThai</span>
                        }
                    </div>
                </div>

                <p class="text-muted small mt-2 mb-2">
                    Gửi lúc @y.ThoiDiemGui.ToString("HH:mm dd/MM/yyyy")
                </p>

                <div class="noidung-box">@y.NoiDung</div>

                @if (!string.IsNullOrWhiteSpace(y.NoiDungTraLoi))
                {
                    <div class="traloi-box mt-3">
                        <div class="fw-bold mb-1">
                            Phản hồi từ quản trị viên
                            @if (y.ThoiDiemTraLoi != null)
                            {
                                <span class="text-muted small fw-normal">
                                    — @y.ThoiDiemTraLoi.Value.ToString("HH:mm dd/MM/yyyy")
                                </span>
                            }
                        </div>
                        <div>@y.NoiDungTraLoi</div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .yeucau-page {
        min-height: 70vh;
        color: #e8ecf5;
    }

    .yeucau-card {
        background: #16213e;
        border: 1px solid #2a3a5e;
        border-radius: 12px;
        padding: 18px 20px;
    }

    .noidung-box {
        background: #0f1830;
        border-radius: 8px;
        padding: 12px 14px;
        white-space: pre-wrap;
        line-height: 1.6;
        color: #c9d4e8;
    }

    .traloi-box {
        background: #12301f;
        border-left: 4px solid #35c46a;
        border-radius: 8px;
        padding: 12px 14px;
        white-space: pre-wrap;
        line-height: 1.6;
        color: #d6f5e0;
    }
</style>

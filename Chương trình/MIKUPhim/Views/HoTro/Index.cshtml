@model List<MIKUPhim.Models.ChatBot>
@{
    ViewData["Title"] = "Hỗ trợ khách hàng";
    var tuKhoa = ViewBag.TuKhoa as string;
    var khongTimThay = ViewBag.KhongTimThay != null && (bool)ViewBag.KhongTimThay;

    var hoTen = TempData["HoTenCu"] as string ?? ViewBag.HoTenMacDinh as string ?? "";
    var email = TempData["EmailCu"] as string ?? ViewBag.EmailMacDinh as string ?? "";
    var tieuDe = TempData["TieuDeCu"] as string ?? "";
    var noiDung = TempData["NoiDungCu"] as string ?? "";
}

<div class="container hotro-page py-5">

    <div class="text-center mb-4">
        <h2 class="hotro-title">Trung tâm hỗ trợ</h2>
        <p class="text-muted">
            Tra cứu câu hỏi thường gặp. Nếu chưa có câu trả lời phù hợp, bạn hãy gửi yêu cầu để
            quản trị viên xử lý.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    @if (TempData["LoiYeuCau"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["LoiYeuCau"]</div>
    }

    <div class="row g-4">

        <!-- ============ CÂU HỎI THƯỜNG GẶP ============ -->
        <div class="col-lg-7">
            <div class="hotro-box">
                <h5 class="mb-3">Câu hỏi thường gặp</h5>

                <form method="get" asp-action="Index" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control"
                               placeholder="Nhập từ khóa: giá vé, thanh toán, hủy vé, combo..." />
                        <button type="submit" class="btn btn-miku-search">Tìm</button>
                        @if (!string.IsNullOrEmpty(tuKhoa))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                        }
                    </div>
                </form>

                @if (khongTimThay)
                {
                    <div class="alert alert-warning">
                        Không tìm thấy câu trả lời cho từ khóa <strong>"@tuKhoa"</strong>.
                        Bạn vui lòng gửi yêu cầu hỗ trợ ở khung bên cạnh.
                    </div>
                }
                else if (!string.IsNullOrEmpty(tuKhoa))
                {
                    <p class="text-muted small">Tìm thấy @Model.Count kết quả cho "@tuKhoa".</p>
                }

                <div class="accordion" id="faqAccordion">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#faq-@item.MaHoiDap">
                                    @item.CauHoi
                                </button>
                            </h2>
                            <div id="faq-@item.MaHoiDap" class="accordion-collapse collapse"
                                 data-bs-parent="#faqAccordion">
                                <div class="accordion-body">@item.TraLoi</div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.Count == 0 && string.IsNullOrEmpty(tuKhoa))
                {
                    <p class="text-muted">Chưa có câu hỏi thường gặp nào.</p>
                }
            </div>
        </div>

        <!-- ============ GỬI YÊU CẦU HỖ TRỢ ============ -->
        <div class="col-lg-5">
            <div class="hotro-box">
                <h5 class="mb-3">Gửi yêu cầu hỗ trợ</h5>

                <form asp-action="GuiYeuCau" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                        <input name="HoTen" value="@hoTen" class="form-control" required maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email liên hệ <span class="text-danger">*</span></label>
                        <input name="Email" value="@email" type="email" class="form-control" required maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                        <input name="TieuDe" value="@tieuDe" class="form-control" required maxlength="200"
                               placeholder="Ví dụ: Cần hủy vé đã đặt nhầm suất" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                        <textarea name="NoiDung" class="form-control" rows="5" required
                                  minlength="10" maxlength="2000"
                                  placeholder="Mô tả chi tiết vấn đề bạn gặp phải (ít nhất 10 ký tự)...">@noiDung</textarea>
                    </div>

                    <button type="submit" class="btn btn-miku-send w-100">Gửi yêu cầu</button>
                </form>

                <hr class="my-4" />

                @if (Context.Session.GetInt32("MaNguoiDung") != null)
                {
                    <a asp-action="YeuCauCuaToi" class="btn btn-outline-light w-100">
                        Xem yêu cầu tôi đã gửi
                    </a>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        Bạn <a asp-controller="Account" asp-action="Login">đăng nhập</a>
                        để theo dõi trạng thái các yêu cầu đã gửi.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .hotro-page {
        min-height: 70vh;
    }

    .hotro-title {
        font-weight: 700;
        color: #00d1ff;
    }

    .hotro-box {
        background: #16213e;
        border: 1px solid #2a3a5e;
        border-radius: 14px;
        padding: 24px;
        height: 100%;
        color: #e8ecf5;
    }

        .hotro-box .form-control {
            background: #0f1830;
            border: 1px solid #2a3a5e;
            color: #e8ecf5;
        }

            .hotro-box .form-control:focus {
                background: #0f1830;
                color: #e8ecf5;
                border-color: #00d1ff;
                box-shadow: 0 0 0 .2rem rgba(0, 209, 255, .15);
            }

            .hotro-box .form-control::placeholder {
                color: #7c8aa5;
            }

    .btn-miku-search, .btn-miku-send {
        background: #00d1ff;
        border: none;
        color: #0d1b2a;
        font-weight: 600;
    }

        .btn-miku-search:hover, .btn-miku-send:hover {
            background: #00b4dd;
            color: #0d1b2a;
        }

    .accordion-item {
        background: #0f1830;
        border: 1px solid #2a3a5e;
        margin-bottom: 8px;
        border-radius: 8px;
        overflow: hidden;
    }

    .accordion-button {
        background: #0f1830;
        color: #e8ecf5;
        font-weight: 500;
    }

        .accordion-button:not(.collapsed) {
            background: #1b2a4a;
            color: #00d1ff;
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: none;
            border-color: #2a3a5e;
        }

        .accordion-button::after {
            filter: invert(1);
        }

    .accordion-body {
        background: #16213e;
        color: #c9d4e8;
        line-height: 1.7;
    }
</style>

@model MIKUPhim.Models.PHIM

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm phim</h2>

<form asp-action="ThemPhim" method="post" enctype="multipart/form-data">

    <div class="row">

        <!-- CỘT TRÁI -->
        <div class="col-md-6">

            <div class="form-group">
                <label>Tên phim</label>
                <input asp-for="TenPhim" class="form-control" />
            </div>

            <div class="form-group">
                <label>Thể loại</label>
                <input asp-for="TheLoai" class="form-control" />
            </div>

            <div class="form-group">
                <label>Đạo diễn</label>
                <input asp-for="DaoDien" class="form-control" />
            </div>

            <div class="form-group">
                <label>Diễn viên</label>
                <input asp-for="DienVien" class="form-control" />
            </div>

            <div class="form-group">
                <label>Thời lượng (phút)</label>
                <input asp-for="ThoiLuong" class="form-control" />
            </div>

            <div class="form-group">
                <label>Độ tuổi</label>
                <input asp-for="DoTuoi" class="form-control" />
            </div>

        </div>


        <!-- CỘT PHẢI -->
        <div class="col-md-6">

            <div class="form-group">
                <label>Ngôn ngữ</label>
                <input asp-for="NgonNgu" class="form-control" />
            </div>

            <div class="form-group">
                <label>Trailer URL</label>
                <input asp-for="TrailerUrl" class="form-control" />
            </div>

            <div class="form-group">

                <label>Poster phim</label>

                <input type="file"
                       name="PosterFile"
                       class="form-control"
                       accept="image/*"
                       onchange="previewPoster(event)" />

            </div>

            <img id="posterPreview"
                 style="width:200px;margin-top:10px;display:none;border-radius:5px;" />

            <div class="form-group">
                <label>Trạng thái</label>

                <select asp-for="TrangThai" class="form-control">

                    <option value="dang_chieu">Đang chiếu</option>
                    <option value="sap_chieu">Sắp chiếu</option>

                </select>

            </div>

        </div>

    </div>


    <div class="form-group" style="margin-top:20px">

        <label>Mô tả phim</label>

<textarea asp-for="MoTa"
          class="form-control"
          rows="4"></textarea>

    </div>


    <br />

    <button type="submit" class="btn btn-success">
        Lưu phim
    </button>

    <a href="/Admin/QuanLyPhim" class="btn btn-secondary">
        Quay lại
    </a>

</form>


<script>

    function previewPoster(event) {
        var reader = new FileReader();

        reader.onload = function () {
            var img = document.getElementById("posterPreview");
            img.src = reader.result;
            img.style.display = "block";
        }

        reader.readAsDataURL(event.target.files[0]);
    }

</script>
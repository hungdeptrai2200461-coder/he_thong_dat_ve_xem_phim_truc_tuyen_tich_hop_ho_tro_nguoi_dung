@model MIKUPhim.Models.NGUOIDUNG

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm người dùng</h2>

<form method="post" enctype="multipart/form-data">

    <div class="row">

        <div class="col-md-6">

            <label>Họ tên</label>
            <input asp-for="HoTen" class="form-control" required />

            <label class="mt-3">Email</label>
            <input asp-for="Email" type="email" class="form-control" required />

            <label class="mt-3">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control" />

            <label class="mt-3">Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" required />

        </div>


        <div class="col-md-6">

            <label>Quyền</label>

            <select asp-for="VaiTro" class="form-control">

                <option value="USER">USER</option>
                <option value="ADMIN">ADMIN</option>

            </select>

            <label class="mt-3">Avatar</label>

            <input type="file"
                   name="AvatarFile"
                   class="form-control" />

        </div>

    </div>

    <br>

    <button class="btn btn-success">
        Lưu
    </button>

    <a href="/Admin/QuanLyNguoiDung"
       class="btn btn-secondary">

        Quay lại

    </a>

</form>
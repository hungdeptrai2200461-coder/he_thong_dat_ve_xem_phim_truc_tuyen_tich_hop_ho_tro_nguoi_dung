@model MIKUPhim.Models.RAP

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm rạp</h2>

<form asp-action="ThemRap" method="post">

    <div class="form-group">

        <label>Tên rạp</label>

        <input asp-for="TenRap" class="form-control" />

    </div>


    <div class="form-group">

        <label>Tỉnh / Thành</label>

        <select asp-for="MaTinh" class="form-control">

            @foreach (var t in ViewBag.TinhThanh)
            {
                <option value="@t.MaTinh">@t.TenTinh</option>
            }

        </select>

    </div>


    <div class="form-group">

        <label>Địa chỉ</label>

        <input asp-for="DiaChi" class="form-control" />

    </div>

    <br>

    <button type="submit" class="btn btn-success">
        Lưu rạp
    </button>

    <a href="/Admin/QuanLyRap" class="btn btn-secondary">
        Quay lại
    </a>

</form>
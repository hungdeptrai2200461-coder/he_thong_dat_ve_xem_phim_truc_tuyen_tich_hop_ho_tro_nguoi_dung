@model IEnumerable<MIKUPhim.Models.KHUYENMAI>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Quản lý khuyến mãi</h2>

<a href="/Admin/ThemKhuyenMai"
   class="btn btn-success mb-3">

    + Thêm khuyến mãi

</a>

<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>Hình</th>
            <th>Tiêu đề</th>
            <th>Mô tả</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Thao tác</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var k in Model)
        {
            <tr>

                <td>

                    <img src="/images/@k.HinhAnh"
                         width="120"
                         style="border-radius:6px" />

                </td>

                <td>@k.TieuDe</td>

                <td style="max-width:300px">

                    @k.MoTa

                </td>

                <td>@k.NgayBatDau.ToString("dd/MM/yyyy")</td>

                <td>@k.NgayKetThuc.ToString("dd/MM/yyyy")</td>

                <td>

                    <a href="/Admin/SuaKhuyenMai/@k.MaKhuyenMai"
                       class="btn btn-warning btn-sm">

                        Sửa

                    </a>

                    <a href="/Admin/XoaKhuyenMai/@k.MaKhuyenMai"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Xóa khuyến mãi này?')">

                        Xóa

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
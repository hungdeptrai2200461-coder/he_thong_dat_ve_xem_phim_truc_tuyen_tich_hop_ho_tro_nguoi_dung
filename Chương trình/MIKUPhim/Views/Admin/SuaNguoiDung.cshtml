@model MIKUPhim.Models.NGUOIDUNG

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Sửa người dùng</h2>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="MaNguoiDung" />

    <div class="row">

        <div class="col-md-6">

            <label>Họ tên</label>
            <input asp-for="HoTen" class="form-control" />

            <label class="mt-3">Email</label>
            <input asp-for="Email" class="form-control" />

            <label class="mt-3">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control" />

            <label class="mt-3">Mật khẩu</label>
            <input asp-for="MatKhau" class="form-control" />

        </div>


        <div class="col-md-6">

            <label>Quyền</label>

            <select asp-for="VaiTro" class="form-control">

                <option value="USER">USER</option>
                <option value="ADMIN">ADMIN</option>

            </select>

            <label class="mt-3">Avatar</label>

            <input type="file"
                   name="AvatarFile"
                   class="form-control" />

            @if (Model.Avatar != null)
            {
                <img src="/images/@Model.Avatar"
                     width="120"
                     class="mt-3"
                     style="border-radius:50%" />
            }

        </div>

    </div>

    <br>

    <button class="btn btn-success">
        Cập nhật
    </button>

    <a href="/Admin/QuanLyNguoiDung"
       class="btn btn-secondary">

        Quay lại

    </a>

</form>
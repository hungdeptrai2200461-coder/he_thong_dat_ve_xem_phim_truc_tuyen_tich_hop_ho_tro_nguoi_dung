@model MIKUPhim.Models.KHUYENMAI

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm khuyến mãi</h2>

<form method="post" enctype="multipart/form-data">

    <label>Tiêu đề</label>

    <input asp-for="TieuDe" class="form-control" />

    <label class="mt-2">Mô tả khuyến mãi</label>

<textarea asp-for="MoTa"
          class="form-control"
          rows="5"
          placeholder="Nhập nội dung khuyến mãi..."></textarea>

    <label class="mt-2">Hình ảnh</label>

    <input type="file"
           name="HinhFile"
           class="form-control" />

    <label class="mt-2">Ngày bắt đầu</label>

    <input asp-for="NgayBatDau"
           type="date"
           class="form-control" />

    <label class="mt-2">Ngày kết thúc</label>

    <input asp-for="NgayKetThuc"
           type="date"
           class="form-control" />

    <br>

    <button class="btn btn-success">

        Lưu

    </button>

    <a href="/Admin/QuanLyKhuyenMai"
       class="btn btn-secondary">

        Quay lại

    </a>

</form>
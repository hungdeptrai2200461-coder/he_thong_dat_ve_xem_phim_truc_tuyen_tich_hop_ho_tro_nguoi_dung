@model List<MIKUPhim.Models.ChatBot>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var search = ViewBag.Search as string;
}

<h2>Quản lý câu hỏi thường gặp</h2>

<p class="text-muted">
    Nội dung hướng dẫn hiển thị cho khách hàng tại trang <strong>Hỗ trợ</strong>.
    Khách tra cứu theo từ khóa trong cột "Câu hỏi / từ khóa".
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

    <a href="/Admin/ThemCauHoi" class="btn btn-success">
        + Thêm câu hỏi
    </a>

    <form method="get" action="/Admin/QuanLyCauHoi" class="d-flex gap-2">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Tìm theo câu hỏi hoặc nội dung..." style="min-width:260px" />
        <button type="submit" class="btn btn-primary">Tìm</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="/Admin/QuanLyCauHoi" class="btn btn-outline-secondary">Xóa lọc</a>
        }
    </form>
</div>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:60px">Mã</th>
            <th style="width:28%">Câu hỏi / từ khóa</th>
            <th>Câu trả lời</th>
            <th style="width:140px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">
                    Chưa có câu hỏi nào.
                </td>
            </tr>
        }
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.MaHoiDap</td>
                <td><strong>@c.CauHoi</strong></td>
                <td>@c.TraLoi</td>
                <td>
                    <a href="/Admin/SuaCauHoi/@c.MaHoiDap" class="btn btn-warning btn-sm">Sửa</a>
                    <a href="/Admin/XoaCauHoi/@c.MaHoiDap" class="btn btn-danger btn-sm"
                       onclick="return confirm('Bạn chắc chắn muốn xóa câu hỏi này?')">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Tổng cộng: <strong>@Model.Count</strong> câu hỏi.</p>

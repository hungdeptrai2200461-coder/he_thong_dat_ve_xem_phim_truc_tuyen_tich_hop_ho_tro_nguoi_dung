@model MIKUPhim.Models.ChatBot

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm câu hỏi thường gặp</h2>

<div class="card">
    <div class="card-body">

        <form asp-action="ThemCauHoi" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Câu hỏi / từ khóa <span class="text-danger">*</span></label>
                <input asp-for="CauHoi" class="form-control"
                       placeholder="Ví dụ: giá vé, hủy vé, thanh toán..." />
                <span asp-validation-for="CauHoi" class="text-danger"></span>
                <div class="form-text">
                    Khách hàng gõ từ khóa này trên trang Hỗ trợ để tìm ra câu trả lời.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Câu trả lời <span class="text-danger">*</span></label>
                <textarea asp-for="TraLoi" class="form-control" rows="6"
                          placeholder="Nhập nội dung trả lời hiển thị cho khách hàng..."></textarea>
                <span asp-validation-for="TraLoi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Lưu</button>
            <a href="/Admin/QuanLyCauHoi" class="btn btn-secondary">Quay lại</a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

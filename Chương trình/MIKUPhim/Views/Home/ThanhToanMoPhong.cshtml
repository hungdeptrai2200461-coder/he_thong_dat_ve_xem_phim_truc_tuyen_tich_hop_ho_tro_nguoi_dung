@{
    ViewData["Title"] = "Xác nhận thanh toán";

    var suat = ViewBag.Suat as MIKUPhim.Models.SUATCHIEU;
    var phuongThuc = ViewBag.PhuongThuc as string;
    var maPhuongThuc = ViewBag.MaPhuongThuc as string;
    decimal tongTien = ViewBag.TongTien ?? 0;
    int maSuatChieu = ViewBag.MaSuatChieu ?? 0;
    var anh = maPhuongThuc == "MOMO" ? "/images/momo.jpg" : "/images/zalopay.jpg";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mophong-box">

                <div class="text-center mb-4">
                    <img src="@anh" alt="@phuongThuc" class="mophong-logo" />
                    <h4 class="mt-3 mb-1">Thanh toán qua @phuongThuc</h4>
                    <span class="badge bg-warning text-dark">Giao dịch mô phỏng</span>
                </div>

                <div class="alert alert-info small">
                    Đây là màn hình thanh toán mô phỏng phục vụ môi trường thử nghiệm.
                    Hệ thống không kết nối tới cổng thanh toán thật và không phát sinh giao dịch tiền tệ.
                </div>

                @if (suat != null)
                {
                    <table class="table table-borderless mophong-table">
                        <tr>
                            <td>Phim</td>
                            <td class="text-end fw-bold">@suat.PHIM?.TenPhim</td>
                        </tr>
                        <tr>
                            <td>Rạp</td>
                            <td class="text-end">@suat.PHONGCHIEU?.RAP?.TenRap</td>
                        </tr>
                        <tr>
                            <td>Phòng chiếu</td>
                            <td class="text-end">@suat.PHONGCHIEU?.TenPhong</td>
                        </tr>
                        <tr>
                            <td>Suất chiếu</td>
                            <td class="text-end">
                                @suat.NgayChieu.ToString("dd/MM/yyyy") —
                                @suat.GioBatDau.ToString(@"hh\:mm")
                            </td>
                        </tr>
                        <tr>
                            <td>Ghế</td>
                            <td class="text-end">@ViewBag.TenGhe</td>
                        </tr>
                        <tr class="mophong-total">
                            <td>Tổng thanh toán</td>
                            <td class="text-end">@tongTien.ToString("N0") đ</td>
                        </tr>
                    </table>
                }

                <form asp-action="XacNhanThanhToanMoPhong" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="phuongThuc" value="@maPhuongThuc" />
                    <input type="hidden" name="maSuatChieu" value="@maSuatChieu" />

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                        Xác nhận thanh toán
                    </button>
                </form>

                <a asp-action="ThanhToan" asp-route-maSuatChieu="@maSuatChieu"
                   class="btn btn-outline-secondary w-100 mt-2">
                    Quay lại chọn phương thức khác
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .mophong-box {
        background: #16213e;
        border: 1px solid #2a3a5e;
        border-radius: 16px;
        padding: 30px;
        color: #e8ecf5;
    }

    .mophong-logo {
        width: 80px;
        height: 80px;
        object-fit: contain;
        border-radius: 12px;
        background: #fff;
        padding: 6px;
    }

    .mophong-table td {
        color: #c9d4e8;
        border-bottom: 1px solid #2a3a5e;
        padding: 10px 0;
    }

    .mophong-total td {
        color: #00d1ff;
        font-size: 18px;
        font-weight: 700;
        border-bottom: none;
    }
</style>

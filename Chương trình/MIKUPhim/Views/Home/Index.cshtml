            background: #00b4dd;
            color: #0d1b2a;
        }

    .search-reset {
        padding: 11px 20px;
        border-radius: 8px;
        border: 1px solid #6c7a92;
        color: #c9d4e8;
        text-decoration: none;
        font-size: 15px;
    }

        .search-reset:hover {
            background: #2a3a5e;
            color: #fff;

@model List<MIKUPhim.Models.PHIM>

@{
    var km = ViewBag.KhuyenMai as List<MIKUPhim.Models.KHUYENMAI>;
}

<!-- SLIDER QUẢNG CÁO -->
@if (km != null && km.Count > 0)
{
    <!-- EVENT TITLE (KHÔNG BỊ ẢNH NỀN) -->
    <div class="event-section">
        <span class="line"></span>
        <h2 class="event-text">EVENT</h2>
        <span class="line"></span>
    </div>

    <!-- KHUNG CHỨA VIDEO + SLIDER -->
    <div class="event-bg-box">

        <!-- VIDEO BACKGROUND -->
        <video class="event-bg-video" autoplay muted loop playsinline>
            <source src="~/images/gifmiku.mp4" type="video/mp4">
        </video>

        <!-- LỚP PHỦ TỐI -->
        <div class="event-overlay"></div>

        <!-- SLIDER -->
        <div class="promo-container" id="promoContainer">

            <div class="promo-slider">

                @for (int i = 0; i < km.Count; i++)
                {
                    <div class="promo-slide fade">

                        <a href="/Home/ChiTietKhuyenMai/@km[i].MaKhuyenMai">

                            <div class="promo-img-wrap">
                                <img src="~/images/@km[i].HinhAnh" class="promo-banner">
                            </div>

                        </a>

                    </div>
                }

            </div>

            <!-- NÚT -->
            <button class="promo-prev" onclick="changeSlide(-1)">&#10094;</button>
            <button class="promo-next" onclick="changeSlide(1)">&#10095;</button>

            <!-- DOTS -->
            <div class="promo-dots">

                @for (int i = 0; i < km.Count; i++)
                {
                    <span class="promo-dot" onclick="currentSlide(@(i+1))"></span>
                }

            </div>

        </div>

    </div>
}
<!-- MOVIE TITLE -->
<div class="event-section">
    <span class="line"></span>
    <h2 class="movie-text">MOVIE SELECTION</h2>
    <span class="line"></span>
</div>

@{
    var dsTheLoai = ViewBag.DanhSachTheLoai as List<string> ?? new List<string>();
    var tuKhoa = ViewBag.TuKhoa as string;
    var theLoaiChon = ViewBag.TheLoai as string;
    var trangThaiChon = ViewBag.TrangThai as string;
    bool dangTimKiem = ViewBag.DangTimKiem != null && (bool)ViewBag.DangTimKiem;
}

<!-- ===================== TÌM KIẾM PHIM ===================== -->
<div class="search-wrapper">

    <form method="get" asp-action="Index" class="search-form">

        <input type="text" name="tuKhoa" value="@tuKhoa" class="search-input"
               placeholder="Tìm theo tên phim, thể loại, đạo diễn, diễn viên..." />

        <select name="theLoai" class="search-select">
            <option value="">Tất cả thể loại</option>
            @foreach (var tl in dsTheLoai)
            {
                if (tl == theLoaiChon)
                {
                    <option value="@tl" selected>@tl</option>
                }
                else
                {
                    <option value="@tl">@tl</option>
                }
            }
        </select>

        <select name="trangThai" class="search-select">
            <option value="">Tất cả trạng thái</option>
            <option value="dang_chieu" selected="@(trangThaiChon == "dang_chieu")">Đang chiếu</option>
            <option value="sap_chieu" selected="@(trangThaiChon == "sap_chieu")">Sắp chiếu</option>
        </select>

        <button type="submit" class="search-btn">Tìm kiếm</button>

        @if (dangTimKiem)
        {
            <a asp-action="Index" class="search-reset">Xóa lọc</a>
        }
    </form>

    @if (dangTimKiem)
    {
        <p class="search-result-text">
            Tìm thấy <strong>@ViewBag.SoKetQua</strong> phim
            @if (!string.IsNullOrWhiteSpace(tuKhoa))
            {
                <text>cho từ khóa "<strong>@tuKhoa</strong>"</text>
            }
        </p>
    }
</div>

@if (dangTimKiem && Model.Count == 0)
{
    <div class="no-result">
        <p>Không tìm thấy phim nào phù hợp.</p>
        <a asp-action="Index" class="search-btn">Xem tất cả phim</a>
    </div>
}

<div class="movie-wrapper @(dangTimKiem ? "is-grid" : "")">

    @if (!dangTimKiem)
    {
        <button class="slider-btn left" onclick="scrollMovies(-1)">
            &#10094;
        </button>
    }

    <div class="movie-slider @(dangTimKiem ? "grid-mode" : "")" id="movieSlider">

        @foreach (var phim in Model)
        {
            <div class="movie-card">

                <!-- Ảnh phim -->
                <img src="~/images/@phim.Poster" class="movie-img" />

                <!-- NÚT PLAY (TÁCH RIÊNG - QUAN TRỌNG) -->
                <div class="play-icon"
                     onclick="openTrailer('@phim.TrailerUrl'); return false;">
                    ▶
                </div>

                <!-- OVERLAY (CHỈ CHỨA PHẦN DƯỚI) -->
                <div class="movie-overlay">

                    <div class="movie-info">

                        <!-- Tên phim -->
                        <h5>@phim.TenPhim</h5>

                        <!-- Nút -->
                        <div class="btn-group">

                            <a asp-action="Details"
                               asp-route-id="@phim.MaPhim"
                               class="btn btn-danger">
                                XEM CHI TIẾT
                            </a>

                            <a asp-action="ChonSuatChieu"
                               asp-route-id="@phim.MaPhim"
                               class="btn btn-outline-light">
                                MUA VÉ
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (!dangTimKiem)
    {
        <button class="slider-btn right" onclick="scrollMovies(1)">
            &#10095;
        </button>
    }

</div>

<!-- CSS cho phần tìm kiếm -->
<style>
    .search-wrapper {
        max-width: 1100px;
        margin: 0 auto 26px;
        padding: 0 20px;
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;

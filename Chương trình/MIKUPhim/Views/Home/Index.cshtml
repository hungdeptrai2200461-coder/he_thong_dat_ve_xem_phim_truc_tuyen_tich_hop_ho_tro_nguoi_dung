        min-width: 240px;
        padding: 11px 16px;
        border-radius: 8px;
        border: 1px solid #2a3a5e;
        background: #16213e;
        color: #e8ecf5;
        font-size: 15px;
    }

        .search-input::placeholder {
            color: #7c8aa5;
        }

        .search-input:focus {
            outline: none;
            border-color: #00d1ff;
            box-shadow: 0 0 0 3px rgba(0, 209, 255, .15);
        }

    .search-select {
        padding: 11px 14px;
        border-radius: 8px;
        border: 1px solid #2a3a5e;
        background: #16213e;
        color: #e8ecf5;
        font-size: 15px;
        cursor: pointer;
    }

        .search-select:focus {
            outline: none;
            border-color: #00d1ff;
        }

    .search-btn {
        padding: 11px 26px;
        border-radius: 8px;
        border: none;
        background: #00d1ff;
        color: #0d1b2a;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;

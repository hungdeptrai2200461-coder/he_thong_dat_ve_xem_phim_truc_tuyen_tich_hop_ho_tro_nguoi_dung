        padding: 0 20px;
    }

    .movie-slider.grid-mode {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        overflow-x: visible;
        max-width: 1200px;
        margin: 0 auto;
    }
</style>

<!-- TRAILER MODAL -->
<div id="trailerModal" class="trailer-modal">
    <div class="trailer-content">
        <span class="close-btn" onclick="closeTrailer()">&times;</span>
        <iframe id="trailerFrame"
                width="100%"
                height="450"
                src=""
                frameborder="0"
                allow="autoplay; encrypted-media"
                allowfullscreen>
        </iframe>
    </div>
</div>

<script>
function scrollMovies(direction) {
    const slider = document.getElementById("movieSlider");
    const scrollAmount = 300;
    slider.scrollLeft += direction * scrollAmount;
}
</script>

<script>
function openTrailer(url) {

    if (url.includes("youtu.be")) {
        var videoId = url.split("/").pop();
        url = "https://www.youtube.com/embed/" + videoId;
    }

    if (url.includes("watch?v=")) {
        url = url.replace("watch?v=", "embed/");
    }

    document.getElementById("trailerFrame").src = url + "?autoplay=1";
    document.getElementById("trailerModal").style.display = "block";
}

function closeTrailer() {
    document.getElementById("trailerFrame").src = "";
    document.getElementById("trailerModal").style.display = "none";
}

window.onclick = function (event) {
    var modal = document.getElementById("trailerModal");
    if (event.target == modal) {
        closeTrailer();
    }
}
</script>

<!-- JS SLIDER -->
<script>

    let slideIndex = 0;
    let slides = document.querySelectorAll(".promo-slide");
    let dots = document.querySelectorAll(".promo-dot");
    let autoSlide;

    function showSlide(index) {

        slides.forEach((s, i) => {

            s.classList.remove("active");
            dots[i].classList.remove("active-dot");

        });

        slides[index].classList.add("active");
        dots[index].classList.add("active-dot");

    }

    function nextSlide() {

        slideIndex++;

        if (slideIndex >= slides.length)
            slideIndex = 0;

        showSlide(slideIndex);

    }

    function changeSlide(n) {

        slideIndex += n;

        if (slideIndex >= slides.length)
            slideIndex = 0;

        if (slideIndex < 0)
            slideIndex = slides.length - 1;

        showSlide(slideIndex);

    }

    function currentSlide(n) {

        slideIndex = n - 1;
        showSlide(slideIndex);

    }

    function startAuto() {

        autoSlide = setInterval(nextSlide, 3000);

    }

    function stopAuto() {

        clearInterval(autoSlide);

    }

    startAuto();

    document.getElementById("promoContainer").addEventListener("mouseover", stopAuto);

    document.getElementById("promoContainer").addEventListener("mouseout", startAuto);

    showSlide(slideIndex);

</script>

<style>

    /* SLIDER */

    .promo-container {
        width: 100%;
        max-width: 1100px;
        margin: 20px auto;
        position: relative; /* 👈 QUAN TRỌNG */
        z-index: 3; /* 👈 QUAN TRỌNG */

        overflow: hidden;
        border-radius: 12px;
        box-shadow: 0 0 30px rgba(0, 230, 195, 0.2);
    }

    .promo-slide {
        position: absolute;
        width: 100%;
        opacity: 0;
        transition: opacity 0.8s ease;
    }

        .promo-slide.active {
            opacity: 1;
            position: relative;
        }

    .promo-banner {
        width: 100%;
        height: 360px;
        object-fit: contain;
        border-radius: 10px;
        background: transparent;
    }

    .fade {
        animation: fadeEffect 1s;
    }

    @@keyframes fadeEffect {
        from {
            opacity: 0.4
        }

        to {
            opacity: 1
        }
    }

    .promo-prev,
    .promo-next {
        cursor: pointer;
        position: absolute;
        top: 50%;
        padding: 12px;
        color: white;
        font-size: 28px;
        background: rgba(0,0,0,0.5);
        border: none;
    }

    .promo-prev {
        left: 10px;
    }

    .promo-next {
        right: 10px;
    }

    .promo-dots {
        text-align: center;
        margin-top: 10px;
    }

    .promo-dot {
        height: 12px;
        width: 12px;
        margin: 4px;
        background: #bbb;
        border-radius: 50%;
        display: inline-block;
        cursor: pointer;
    }

    .active-dot {
        background: #e50914;
    }

/* TRAILER */

.trailer-modal {
display:none;
position:fixed;
z-index:9999;
left:0;
top:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.8);
}

.trailer-content {
position:relative;
width:70%;
margin:5% auto;
background:black;
padding:10px;
}

.close-btn {
position:absolute;
top:-10px;
right:-10px;
background:white;
color:black;
font-size:24px;
font-weight:bold;
width:35px;
height:35px;
border-radius:50%;
text-align:center;
line-height:35px;
cursor:pointer;
}

    .event-section {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80%;
        margin: 40px auto;
    }

    .event-text {
        position: relative;
        font-size: 34px;
        font-weight: 900;
        letter-spacing: 6px;
        margin: 0 20px;
        color: #00e6c3;
        text-transform: uppercase;
        text-shadow: 0 0 5px #00e6c3, 0 0 10px #00c2a8;
    }

        .event-text::after {
            content: "EVENT";
            position: absolute;
            left: 0;
            top: 0;
            color: transparent;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,0.9), transparent );
            background-size: 200%;
            -webkit-background-clip: text;
            animation: shine 3s infinite;
        }

    /* Razor nhớ @@ */
    @@keyframes shine {
        0% {
            background-position: -200%;
        }

        100% {
            background-position: 200%;
        }
    }

    .line {
        flex: 1;
        height: 2px;
        background: linear-gradient(to right, transparent, #00e6c3, transparent);
    }
    /* MOVIE SELECTION */

    .movie-text {
        position: relative;
        font-size: 34px;
        font-weight: 900;
        letter-spacing: 6px;
        margin: 0 20px;
        color: #00e6c3;
        text-transform: uppercase;
        text-shadow: 0 0 5px #00e6c3, 0 0 10px #00c2a8;
    }

        /* hiệu ứng shine giống EVENT */
        .movie-text::after {
            content: "MOVIE SELECTION";
            position: absolute;
            left: 0;
            top: 0;
            color: transparent;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,0.9), transparent );
            background-size: 200%;
            -webkit-background-clip: text;
            animation: shine 3s infinite;
        }
    /* ===== SPARKLE EFFECT ===== */

    .event-text, .movie-text {
        animation: glowPulse 2s infinite alternate;
    }

    /* nhịp glow */
    @@keyframes glowPulse {
        0% {
            text-shadow: 0 0 5px #00e6c3, 0 0 10px #00c2a8;
        }

        100% {
            text-shadow: 0 0 15px #00e6c3, 0 0 30px #00e6c3, 0 0 50px #00e6c3;
        }
    }

    /* ===== SPARKLE DOTS ===== */

    .event-text::before,
    .movie-text::before {
        content: "✦ ✧ ✦";
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 14px;
        color: #00e6c3;
        opacity: 0.8;
        animation: sparkleMove 3s infinite linear;
    }

    /* sparkle chạy */
    @@keyframes sparkleMove {
        0% {
            transform: translateX(-50%) translateY(0);
            opacity: 0;
        }

        50% {
            opacity: 1;
        }

        100% {
            transform: translateX(-50%) translateY(-10px);
            opacity: 0;
        }
    }

    /* ===== LINE CHẠY ===== */

    .line {
        position: relative;
        overflow: hidden;
    }

        .line::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100%;
            background: linear-gradient(to right, transparent, #00e6c3, transparent);
            animation: lineMove 2s infinite linear;
        }

    /* line chạy */
    @@keyframes lineMove {
        0% {
            left: -100px;
        }

        100% {
            left: 100%;
        }
    }

    /* ===== HOVER XỊN ===== */

    .event-text:hover,
    .movie-text:hover {
        transform: scale(1.1) rotate(-1deg);
        transition: 0.3s;
    }

</style>
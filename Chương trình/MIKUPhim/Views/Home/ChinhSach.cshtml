@{
    ViewData["Title"] = "Chính sách";
}

<div class="policy-wrapper">

    <!-- SIDEBAR -->
    <div class="policy-sidebar">
        <ul>
            <li><a href="#gioithieu">📌 Giới thiệu</a></li>
            <li><a href="#dieukhoan">📜 Điều khoản</a></li>
            <li><a href="#datve">🎟 Đặt vé</a></li>
            <li><a href="#thanhtoan">💳 Thanh toán</a></li>
            <li><a href="#huyve">❌ Huỷ vé</a></li>
            <li><a href="#combo">🍿 Combo</a></li>
            <li><a href="#rap">🎬 Quy định rạp</a></li>
            <li><a href="#baomat">🔐 Bảo mật</a></li>
            <li><a href="#faq">❓ FAQ</a></li>
        </ul>
    </div>

    <!-- CONTENT -->
    <div class="policy-main">

        <h1 class="policy-title">📖 CHÍNH SÁCH & QUY ĐỊNH</h1>

        <!-- GIỚI THIỆU -->
        <section id="gioithieu" class="policy-section">
            <h3>📌 Giới thiệu</h3>
            <p>
                Chào mừng bạn đến với hệ thống đặt vé xem phim trực tuyến <b>MIKUPhim</b>.
                Đây là nền tảng giúp người dùng dễ dàng tra cứu lịch chiếu, lựa chọn ghế ngồi
                và thanh toán trực tuyến một cách nhanh chóng.
            </p>
            <p>
                Hệ thống mô phỏng hoạt động của các rạp chiếu phim hiện đại với các chức năng như giữ ghế,
                thanh toán online và quản lý vé bằng mã QR.
            </p>
            <p>
                Khi sử dụng dịch vụ, bạn đồng ý tuân thủ các chính sách dưới đây.
            </p>
        </section>

        <!-- ĐIỀU KHOẢN -->
        <section id="dieukhoan" class="policy-section">
            <h3>📜 Điều khoản sử dụng</h3>
            <ul>
                <li>Cung cấp thông tin chính xác khi đăng ký và đặt vé</li>
                <li>Không gian lận hoặc phá hoại hệ thống</li>
                <li>Không gây ảnh hưởng đến người dùng khác</li>
                <li>Hệ thống có quyền khóa tài khoản nếu vi phạm</li>
            </ul>
        </section>

        <!-- ĐẶT VÉ -->
        <section id="datve" class="policy-section">
            <h3>🎟 Chính sách đặt vé</h3>
            <ul>
                <li>Chọn ghế trực quan theo sơ đồ</li>
                <li>Giữ ghế tối đa <b>10 phút</b></li>
                <li>Không trùng ghế khi nhiều người đặt</li>
                <li>Vé hợp lệ khi thanh toán thành công</li>
            </ul>
        </section>

        <!-- THANH TOÁN -->
        <section id="thanhtoan" class="policy-section">
            <h3>💳 Chính sách thanh toán</h3>
            <ul>
                <li>Hỗ trợ VNPay và ví điện tử</li>
                <li>Giao dịch được mã hóa bảo mật</li>
                <li>Thanh toán trong thời gian giữ ghế</li>
                <li>Thất bại → ghế tự động mở lại</li>
            </ul>
        </section>

        <!-- HUỶ VÉ -->
        <section id="huyve" class="policy-section">
            <h3>❌ Chính sách huỷ vé</h3>
            <ul>
                <li>Không hoàn tiền sau thanh toán</li>
                <li>Không đổi vé cá nhân</li>
                <li>Lỗi hệ thống sẽ được hỗ trợ</li>
            </ul>
        </section>

        <!-- COMBO -->
        <section id="combo" class="policy-section">
            <h3>🍿 Chính sách combo</h3>
            <ul>
                <li>Áp dụng cho suất chiếu đã đặt</li>
                <li>Nhận tại quầy khi đến rạp</li>
                <li>Không hoàn tiền combo</li>
            </ul>
        </section>

        <!-- RẠP -->
        <section id="rap" class="policy-section">
            <h3>🎬 Quy định tại rạp</h3>
            <ul>
                <li>Không quay phim, chụp ảnh</li>
                <li>Không mang đồ ăn ngoài</li>
                <li>Giữ trật tự trong phòng chiếu</li>
            </ul>
        </section>

        <!-- BẢO MẬT -->
        <section id="baomat" class="policy-section">
            <h3>🔐 Chính sách bảo mật</h3>
            <ul>
                <li>Bảo mật thông tin khách hàng</li>
                <li>Không chia sẻ dữ liệu cho bên thứ 3</li>
                <li>Lưu trữ theo tiêu chuẩn bảo mật</li>
            </ul>
        </section>

        <!-- FAQ -->
        <section id="faq" class="policy-section">
            <h3>❓ FAQ</h3>

            <div class="faq-item">
                <p><b>❓ Tôi có thể đổi vé không?</b></p>
                <p>→ Không</p>
            </div>

            <div class="faq-item">
                <p><b>❓ Thanh toán lỗi?</b></p>
                <p>→ Vé bị huỷ và ghế mở lại</p>
            </div>

            <div class="faq-item">
                <p><b>❓ Nhận vé?</b></p>
                <p>→ Nhận mã QR</p>
            </div>

            <div class="faq-item">
                <p><b>❓ Có cần in vé?</b></p>
                <p>→ Không cần</p>
            </div>

        </section>

    </div>

</div>

<script>
    const sections = document.querySelectorAll(".policy-section");
    const links = document.querySelectorAll(".policy-sidebar a");

    window.addEventListener("scroll", () => {
        let current = "";

        sections.forEach(section => {
            const top = section.offsetTop - 150;
            if (window.scrollY >= top) {
                current = section.id;
            }
        });

        links.forEach(link => {
            link.classList.remove("active");
            if (link.getAttribute("href") === "#" + current) {
                link.classList.add("active");
            }
        });
    });
</script>
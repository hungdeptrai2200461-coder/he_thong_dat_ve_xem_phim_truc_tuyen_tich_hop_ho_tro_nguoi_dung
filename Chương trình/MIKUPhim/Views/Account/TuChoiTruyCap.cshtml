@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="tuchoi-box text-center">

                <div class="tuchoi-icon">&#128274;</div>

                <h3 class="mt-3 mb-2">Không có quyền truy cập</h3>

                <p class="text-muted mb-4">
                    Tài khoản của bạn không được phép sử dụng chức năng này.
                    Khu vực quản trị chỉ dành cho tài khoản có vai trò quản trị viên.
                </p>

                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-miku">
                        Về trang chủ
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                        Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tuchoi-box {
        background: #16213e;
        border: 1px solid #2a3a5e;
        border-radius: 16px;
        padding: 40px 30px;
        color: #e8ecf5;
    }

    .tuchoi-icon {
        font-size: 56px;
        line-height: 1;
    }

    .btn-miku {
        background: #00d1ff;
        border: none;
        color: #0d1b2a;
        font-weight: 600;
    }

        .btn-miku:hover {
            background: #00b4dd;
            color: #0d1b2a;
        }
</style>

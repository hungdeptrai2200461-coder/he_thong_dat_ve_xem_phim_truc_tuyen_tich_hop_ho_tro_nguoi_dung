<h2 class="login-title">Đăng nhập</h2>

<div class="login-container">

    <!-- PARTICLES -->
    <div id="particles"></div>

    <div class="login-card">

        <!-- LEFT: FORM -->
        <div class="login-left">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2">@TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label>Email</label>
                    <input name="email" type="email" class="form-control"
                           placeholder="Nhập email..." required />
                </div>

                <div class="mb-3 password-box">
                    <label>Mật khẩu</label>

                    <input id="password" name="matKhau" type="password" class="form-control"
                           placeholder="Nhập mật khẩu..." required />

                    <span class="toggle-password" onclick="togglePassword()">👁</span>
                </div>

                <button type="submit" class="btn-login">
                    Đăng nhập
                </button>

            </form>

            @if (ViewBag.Loi != null)
            {
                <p class="text-danger mt-2">@ViewBag.Loi</p>
            }

            <p class="mt-3 mb-0" style="color:#9aa7bd;font-size:14px">
                Chưa có tài khoản?
                <a asp-action="Register" style="color:#00d1ff">Đăng ký ngay</a>
                <br />
                Quên mật khẩu?
                <a asp-controller="HoTro" asp-action="Index" style="color:#00d1ff">Gửi yêu cầu hỗ trợ</a>
            </p>

        </div>

        <!-- RIGHT: MIKU -->
        <div class="login-right">

            <video autoplay loop muted playsinline>
                <source src="~/images/gifmikuchao.mp4" type="video/mp4">
            </video>

            <h4 id="miku-text">...</h4>

        </div>

    </div>

</div>